# Estimate Probe Object Reused

A reused-object line in a PROBE size estimate.

◇

attributes:
    - key: name
      name: Name
      rules: unconstrained
      type_spec: STRING
    - key: loc
      name: Loc
      rules: "[0 .. unconstrained] at 1 loc"
      type_spec: Nat
    - key: actual_loc
      name: Actual Loc
      details: SQL column acual_loc.
      rules: "[0 .. unconstrained] at 1 loc"
      type_spec: Nat

associations:
    - name: For Phase
      details: Phase this reused-object line is for.
      from_multiplicity: any
      to_class_key: definition/phase
      to_multiplicity: "1"
