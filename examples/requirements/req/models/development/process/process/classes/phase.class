# Phase

A set of scripts within a process. A phase runs once or is repeating.

◇

attributes:
    - key: num
      name: Num
      details: Order of this phase within the process.
      rules: "[0 .. unconstrained] at 1 unit"
      type_spec: Nat
    - key: name
      name: Name
      details: Unique among phases of the same process.
      rules: unconstrained
      type_spec: STRING
    - key: task_summary
      name: Task Summary
      rules: unconstrained
      type_spec: STRING
    - key: purpose
      name: Purpose
      rules: unconstrained
      type_spec: STRING
    - key: entry_criteria
      name: Entry Criteria
      rules: unconstrained
      type_spec: STRING
    - key: exit_criteria
      name: Exit Criteria
      rules: unconstrained
      type_spec: STRING
    - key: type
      name: Type
      details: Whether this phase runs once or is repeating.
      rules: enum of once, repeating
      type_spec: STRING

invariants:
    - details: Script name is unique among scripts of this phase.
      specification: '\A s \in self.HasScripts : _FiniteSets!Cardinality({ q \in self.HasScripts : q.name = s.name }) = 1'

associations:
    - name: Has Scripts
      details: Ordered scripts that make up this phase.
      from_multiplicity: "1"
      to_class_key: script
      to_multiplicity: any
      uniqueness:
          - to_attributes:
                - num
