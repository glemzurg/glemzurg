# Task

Project-specific estimate of a process step task.

◇

attributes:
    - key: planned_hours
      name: Planned Hours
      rules: "[0 .. unconstrained] at 1 hour"
      type_spec: Nat
    - key: pct_complete
      name: Pct Complete
      rules: "[0 .. 100] at 1 percent"
      type_spec: Nat

associations:
    - name: For Step Task
      details: Process step task this project task estimates.
      from_multiplicity: any
      to_class_key: process/process/step_task
      to_multiplicity: "1"
    - name: On Week
      details: Schedule week this task is planned for.
      from_multiplicity: any
      to_class_key: schedule/schedule_week
      to_multiplicity: "1"
